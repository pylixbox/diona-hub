# Copy to .env and fill in real values. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
DB_PASSWORD=YOUR_PASSWORD
DATABASE_URL=postgresql://diona:YOUR_PASSWORD@localhost:5432/diona_hub
NODE_API_KEY=your-secret-node-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
OTX_API_KEY=your-otx-api-key-here
TLS_ENABLED=true
NODE_STALE_MINUTES=5
